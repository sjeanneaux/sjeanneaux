---
const berufe = [
  // Metalltechnik
  { bereich: 'Metalltechnik', name: 'Industriemechaniker/in', dauer: '3,5 Jahre', variant: 'technik' },
  { bereich: 'Metalltechnik', name: 'Zerspanungsmechaniker/in', dauer: '3,5 Jahre', variant: 'technik' },
  { bereich: 'Metalltechnik', name: 'Anlagenmechaniker/in SHK', dauer: '3,5 Jahre', variant: 'technik' },
  { bereich: 'Metalltechnik', name: 'Konstruktionsmechaniker/in', dauer: '3,5 Jahre', variant: 'technik' },
  // Elektrotechnik
  { bereich: 'Elektrotechnik', name: 'Elektroniker/in', dauer: '3,5 Jahre', variant: 'technik' },
  { bereich: 'Elektrotechnik', name: 'Elektroanlagenmonteur/in', dauer: '3 Jahre', variant: 'technik' },
  // Holztechnik
  { bereich: 'Holztechnik', name: 'Tischler/in', dauer: '3 Jahre', variant: 'technik' },
  { bereich: 'Holztechnik', name: 'Holzmechaniker/in', dauer: '3 Jahre', variant: 'technik' },
  // Fahrzeugtechnik
  { bereich: 'Fahrzeugtechnik', name: 'Kfz-Mechatroniker/in', dauer: '3,5 Jahre', variant: 'technik' },
  { bereich: 'Fahrzeugtechnik', name: 'Zweiradmechatroniker/in', dauer: '3,5 Jahre', variant: 'technik' },
  // Wirtschaft
  { bereich: 'Wirtschaft', name: 'Industriekaufmann/-frau', dauer: '3 Jahre', variant: 'wirtschaft' },
  { bereich: 'Wirtschaft', name: 'Kaufmann/-frau f. Büromanagement', dauer: '3 Jahre', variant: 'wirtschaft' },
  { bereich: 'Wirtschaft', name: 'Verkäufer/in', dauer: '2 Jahre', variant: 'wirtschaft' },
  { bereich: 'Wirtschaft', name: 'Kaufmann/-frau im Einzelhandel', dauer: '3 Jahre', variant: 'wirtschaft' },
  // Ernährung
  { bereich: 'Ernährung', name: 'Koch/Köchin', dauer: '3 Jahre', variant: 'ernaehrung' },
  { bereich: 'Ernährung', name: 'Bäcker/in', dauer: '3 Jahre', variant: 'ernaehrung' },
  { bereich: 'Ernährung', name: 'Konditor/in', dauer: '3 Jahre', variant: 'ernaehrung' },
  { bereich: 'Ernährung', name: 'Fachkraft Gastronomie', dauer: '2 Jahre', variant: 'ernaehrung' },
];

const variantStyles: Record<string, string> = {
  technik: 'border-blue-200 bg-blue-50/60',
  wirtschaft: 'border-green-200 bg-green-50/60',
  ernaehrung: 'border-orange-200 bg-orange-50/60',
};

const badgeStyles: Record<string, string> = {
  technik: 'bg-blue-100 text-blue-800',
  wirtschaft: 'bg-green-100 text-green-800',
  ernaehrung: 'bg-orange-100 text-orange-800',
};
---

<section id="ausbildungsberufe" class="py-20 bg-white">
  <div class="container">
    <div class="text-center mb-14 animate-on-scroll">
      <h2 class="section-heading">Ausbildungsberufe</h2>
      <p class="section-subtitle">Wir beschulen zahlreiche Ausbildungsberufe in verschiedenen Berufsfeldern der Region</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {berufe.map((beruf, i) => (
        <div
          class={`p-4 rounded-xl border-l-4 ${variantStyles[beruf.variant]} hover:shadow-md hover:translate-x-1 transition-all duration-200 animate-on-scroll`}
          style={`transition-delay: ${(i % 8) * 60}ms`}
        >
          <span class={`inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-2 ${badgeStyles[beruf.variant]}`}>
            {beruf.bereich}
          </span>
          <h4 class="font-semibold text-wks-dark text-sm mb-1">{beruf.name}</h4>
          <p class="text-xs text-muted-foreground">{beruf.dauer} Ausbildung</p>
        </div>
      ))}
    </div>
  </div>
</section>
