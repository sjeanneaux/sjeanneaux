---
const news = [
  {
    date: '04. März 2026',
    title: 'Tag der offenen Tür 2026',
    text: 'Erleben Sie unsere Schule hautnah! Informieren Sie sich über unsere Schulformen und lernen Sie unser engagiertes Kollegium kennen. Alle Interessierten sind herzlich willkommen.',
    category: 'Veranstaltung',
    color: 'from-wks-primary to-wks-dark',
    icon: '📖',
  },
  {
    date: '28. Februar 2026',
    title: 'Erfolge bei den Landesmeisterschaften',
    text: 'Unsere Schülerinnen und Schüler haben bei den hessischen Landesmeisterschaften hervorragende Ergebnisse erzielt. Herzlichen Glückwunsch an alle Beteiligten!',
    category: 'Erfolg',
    color: 'from-amber-500 to-amber-700',
    icon: '🏆',
  },
  {
    date: '15. Februar 2026',
    title: 'Nachhaltigkeitsprojekt gestartet',
    text: 'Die WKS startet ein neues Projekt zur Förderung von Nachhaltigkeit und Umweltbewusstsein im Schulalltag. Schülerinnen und Schüler aller Abteilungen sind eingeladen mitzumachen.',
    category: 'Projekt',
    color: 'from-green-600 to-green-800',
    icon: '🌱',
  },
];
---

<section id="aktuelles" class="py-20 bg-white">
  <div class="container">
    <div class="text-center mb-14 animate-on-scroll">
      <h2 class="section-heading">Aktuelles</h2>
      <p class="section-subtitle">Neuigkeiten und Veranstaltungen an der Wilhelm-Knapp-Schule</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
      {news.map((item, i) => (
        <article
          class="group rounded-2xl border bg-card overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 animate-on-scroll"
          style={`transition-delay: ${i * 120}ms`}
        >
          <!-- Image area -->
          <div class={`h-48 bg-gradient-to-br ${item.color} flex items-center justify-center text-5xl`}>
            {item.icon}
          </div>
          <!-- Content -->
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-semibold text-wks-primary bg-wks-light px-2.5 py-0.5 rounded-full">
                {item.category}
              </span>
              <span class="text-xs text-muted-foreground">{item.date}</span>
            </div>
            <h3 class="font-bold text-lg text-wks-dark mb-2 group-hover:text-wks-primary transition-colors">
              {item.title}
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed mb-4">{item.text}</p>
            <a
              href="#"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-wks-primary hover:gap-2.5 transition-all"
            >
              Weiterlesen
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
