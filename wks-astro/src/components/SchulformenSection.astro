---
const paths = [
  {
    title: 'Berufliches Gymnasium',
    why: 'University preparation with real-world skills.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
    href: '/schulformen#berufliches-gymnasium',
  },
  {
    title: 'Fachoberschule',
    why: 'Direct path to technical careers with hands-on learning.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    href: '/schulformen#fachoberschule',
  },
  {
    title: 'Berufsfachschule',
    why: 'Direct path to technical careers with hands-on learning.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    href: '/schulformen#berufsfachschule',
  },
  {
    title: 'Dual Vocational Training',
    why: 'Direct path to technical careers with hands-on learning.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    href: '/schulformen#berufsschule',
  },
];
---

<section id="schulformen" class="py-16 bg-[#f5f7fa]">
  <div class="container">
    <h2 class="text-3xl font-bold text-wks-navy text-center mb-10 animate-on-scroll">
      Educational Paths
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
      {paths.map((path, i) => (
        <a
          href={path.href}
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 animate-on-scroll block"
          style={`transition-delay: ${i * 80}ms`}
        >
          <!-- Icon circle -->
          <div class="w-12 h-12 rounded-full bg-wks-navy flex items-center justify-center mb-4 group-hover:bg-wks-blue transition-colors">
            <Fragment set:html={path.icon} />
          </div>

          <!-- Title -->
          <h3 class="text-lg font-bold text-gray-900 mb-2">{path.title}</h3>

          <!-- Why -->
          <p class="text-sm text-gray-600 leading-relaxed">
            <span class="text-wks-orange font-semibold">Why choose us: </span>
            {path.why}
          </p>
        </a>
      ))}
    </div>

    <div class="text-center mt-10 animate-on-scroll">
      <a
        href="/schulformen"
        class="inline-flex items-center gap-2 px-7 py-3 bg-wks-navy text-white font-semibold rounded-xl hover:bg-wks-navy-dark transition-all hover:-translate-y-0.5 hover:shadow-md text-sm"
      >
        Alle Schulformen ansehen
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
