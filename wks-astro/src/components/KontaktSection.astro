---
import ContactForm from './ContactForm.tsx';
---

<section id="kontakt" class="py-20 bg-[#f5f7fa]">
  <div class="container">
    <div class="text-center mb-14 animate-on-scroll">
      <h2 class="section-heading">Kontakt</h2>
      <p class="section-subtitle">Wir freuen uns auf Ihre Nachricht</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 max-w-5xl mx-auto">
      <!-- Contact Info -->
      <div class="space-y-4 animate-on-scroll">
        {[
          { icon: '📞', title: 'Telefon', val: '06471 / 489-0', href: 'tel:+4964714890' },
          { icon: '📠', title: 'Telefax', val: '06471 / 489-290', href: null },
          { icon: '✉️', title: 'E-Mail', val: 'verwaltung@wks-weilburg.de', href: 'mailto:verwaltung@wks-weilburg.de' },
          { icon: '📍', title: 'Adresse', val: 'Frankfurter Str. 40, 35781 Weilburg', href: null },
          { icon: '🕐', title: 'Öffnungszeiten', val: 'Mo–Do: 07:30–15:30 | Fr: 07:30–13:00', href: null },
        ].map(item => (
          <div class="flex gap-4 p-4 bg-white rounded-xl border border-border/60 shadow-sm">
            <div class="w-10 h-10 rounded-lg bg-wks-navy flex items-center justify-center text-lg shrink-0">
              {item.icon}
            </div>
            <div>
              <p class="text-xs font-semibold text-wks-navy uppercase tracking-wide mb-0.5">{item.title}</p>
              {item.href
                ? <a href={item.href} class="text-sm text-muted-foreground hover:text-wks-navy transition-colors">{item.val}</a>
                : <p class="text-sm text-muted-foreground">{item.val}</p>
              }
            </div>
          </div>
        ))}

        <!-- OpenStreetMap -->
        <div class="rounded-xl overflow-hidden border border-border/60 shadow-sm" style="height:220px">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=8.2525%2C50.4830%2C8.2640%2C50.4890&layer=mapnik&marker=50.4860%2C8.2580"
            allowfullscreen
            loading="lazy"
            title="Standort Wilhelm-Knapp-Schule"
            class="w-full h-full border-0"
          ></iframe>
        </div>
      </div>

      <!-- Form -->
      <div class="bg-white rounded-2xl border border-border/60 shadow-sm p-8 animate-on-scroll" style="transition-delay:150ms">
        <h3 class="font-bold text-wks-navy text-lg mb-6">Schreiben Sie uns</h3>
        <ContactForm client:visible />
      </div>
    </div>
  </div>
</section>
