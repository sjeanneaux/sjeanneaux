---
---

<section class="bg-wks-navy text-white overflow-hidden">
  <div class="container">
    <div class="flex flex-col md:flex-row items-end md:items-stretch min-h-[360px]">

      <!-- Person image (left column) -->
      <div class="md:w-64 lg:w-80 shrink-0 flex items-end justify-center pt-8 md:pt-0">
        <!-- Placeholder that mimics a person photo -->
        <div class="relative w-56 md:w-full h-72 md:h-full">
          <!-- Silhouette placeholder -->
          <svg viewBox="0 0 220 340" xmlns="http://www.w3.org/2000/svg" class="w-full h-full object-contain" aria-label="Principal photo">
            <!-- Body (business attire) -->
            <rect x="40" y="120" width="140" height="220" rx="8" fill="#1e5f8e" opacity="0.6"/>
            <!-- Shirt/collar -->
            <rect x="85" y="118" width="50" height="30" rx="4" fill="#d0e8f5" opacity="0.8"/>
            <!-- Head -->
            <ellipse cx="110" cy="90" rx="38" ry="45" fill="#c9956a"/>
            <!-- Hair -->
            <ellipse cx="110" cy="60" rx="40" ry="30" fill="#7b4f38"/>
            <!-- Arms crossed suggestion -->
            <rect x="35" y="180" width="150" height="28" rx="14" fill="#1e5f8e" opacity="0.5"/>
            <!-- Name badge subtle -->
            <text x="110" y="310" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="white" opacity="0.5" font-weight="600">Dr. Maria Weber</text>
          </svg>
        </div>
      </div>

      <!-- Text content (right column) -->
      <div class="flex-1 flex items-center py-12 md:py-16 md:pl-10 lg:pl-16">
        <div class="max-w-xl">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-5">
            Welcome to<br />
            Wilhelm-Knapp-Schule:<br />
            <span class="text-white">Your Future Starts Here.</span>
          </h1>

          <blockquote class="text-white/75 text-sm md:text-base mb-1 leading-relaxed italic">
            "We empower students through practical education and personal growth.
            Join our supportive community."
          </blockquote>
          <p class="text-white/60 text-sm mb-8 font-medium">— Principal Dr. Maria Weber</p>

          <a
            href="/schulformen"
            class="inline-flex items-center gap-2 px-6 py-3 bg-wks-orange text-white font-semibold rounded-lg hover:bg-wks-orange-dark transition-all hover:-translate-y-0.5 hover:shadow-lg text-sm md:text-base"
          >
            Explore Our Programs
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
