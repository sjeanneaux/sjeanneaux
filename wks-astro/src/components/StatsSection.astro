---
const stats = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    value: '6',
    label: 'Schulformen',
    description: 'Vom Abitur bis zur Berufsausbildung',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    value: '2.000+',
    label: 'Schülerinnen & Schüler',
    description: 'Engagierte Schulgemeinschaft',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>`,
    value: '120+',
    label: 'Lehrkräfte',
    description: 'Qualifiziert und engagiert',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`,
    value: '1905',
    label: 'Gegründet',
    description: 'Über 100 Jahre Bildungstradition',
  },
];
---

<div class="container -mt-12 relative z-10">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
    {stats.map((stat, i) => (
      <div
        class="bg-white rounded-2xl p-6 shadow-lg border border-border/50 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 animate-on-scroll text-center"
        style={`transition-delay: ${i * 100}ms`}
      >
        <div class="w-14 h-14 rounded-xl bg-wks-light flex items-center justify-center mx-auto mb-3 text-wks-primary">
          <Fragment set:html={stat.icon} />
        </div>
        <div class="text-3xl font-extrabold text-wks-dark mb-1">{stat.value}</div>
        <div class="font-semibold text-sm text-wks-primary mb-1">{stat.label}</div>
        <div class="text-xs text-muted-foreground">{stat.description}</div>
      </div>
    ))}
  </div>
</div>
