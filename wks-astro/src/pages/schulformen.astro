---
import Layout from '../layouts/Layout.astro';
import { Badge } from '../components/ui/badge.tsx';

const schulformen = [
  {
    id: 'berufliches-gymnasium',
    title: 'Berufliches Gymnasium',
    abschluss: 'Allgemeine Hochschulreife (Abitur)',
    dauer: '3 Jahre (Klasse 11–13)',
    voraussetzung: 'Qualifizierender Mittlerer Abschluss, Ø mind. 3,0 in Deutsch, Mathe, Englisch',
    beschreibung: 'Das Berufliche Gymnasium führt zur allgemeinen Hochschulreife und bietet dabei einen beruflichen Schwerpunkt. Die Ausbildungsrichtungen Technik (Schwerpunkt Mechatronik) und Wirtschaft (Schwerpunkt Datenverarbeitung) verbinden akademische Bildung mit praxisorientiertem Fachwissen.',
    faecher: ['Deutsch', 'Mathematik', 'Englisch', 'Sport', 'Religionslehre', 'Gemeinschaftskunde', 'Berufsbezogene Fächer'],
    icon: '🎓',
    badge: 'Abitur',
    color: 'bg-blue-50 border-blue-200',
  },
  {
    id: 'fachoberschule',
    title: 'Fachoberschule (FOS)',
    abschluss: 'Fachhochschulreife',
    dauer: '2 Jahre (Form A) / 1 Jahr (Form B)',
    voraussetzung: 'Mittlerer Abschluss; Form B zusätzlich: abgeschlossene Berufsausbildung',
    beschreibung: 'Die Fachoberschule führt zur Fachhochschulreife in den Fachrichtungen Technik, Wirtschaft oder Gestaltung. Form A umfasst ein gelenktes Praktikum im ersten Jahr. Form B richtet sich an Absolventen einer Berufsausbildung.',
    faecher: ['Deutsch', 'Mathematik', 'Englisch', 'Physik/Chemie', 'Berufsbezogener Lernbereich', 'Praktikum (Form A)'],
    icon: '📘',
    badge: 'Fachhochschulreife',
    color: 'bg-indigo-50 border-indigo-200',
  },
  {
    id: 'berufsfachschule',
    title: 'Berufsfachschule',
    abschluss: 'Mittlerer Abschluss + berufliche Grundbildung',
    dauer: '1–2 Jahre',
    voraussetzung: 'Hauptschulabschluss oder gleichwertiger Abschluss',
    beschreibung: 'Die Berufsfachschule vermittelt berufliche Grundkenntnisse und führt zum mittleren Bildungsabschluss. Angeboten werden Bildungsgänge in den Bereichen Wirtschaft & Verwaltung, Metalltechnik, Elektrotechnik sowie Ernährung & Hauswirtschaft.',
    faecher: ['Allgemeinbildende Fächer', 'Berufsbezogener Lernbereich', 'Fachpraktischer Unterricht'],
    icon: '📄',
    badge: 'Mittlerer Abschluss',
    color: 'bg-green-50 border-green-200',
  },
  {
    id: 'berufsschule',
    title: 'Berufsschule (Duales System)',
    abschluss: 'Berufsschulabschluss (Teil der dualen Ausbildung)',
    dauer: '2–3,5 Jahre je nach Ausbildungsberuf',
    voraussetzung: 'Ausbildungsvertrag mit einem anerkannten Ausbildungsbetrieb',
    beschreibung: 'Die Berufsschule ist Teil der dualen Berufsausbildung. Neben dem praktischen Teil im Betrieb erhalten Auszubildende hier die theoretische Grundlage. Wir beschulen zahlreiche Berufe in Metalltechnik, Elektrotechnik, Holztechnik, Fahrzeugtechnik, Wirtschaft sowie Ernährung.',
    faecher: ['Berufsübergreifender Lernbereich', 'Berufsbezogener Lernbereich', 'Differenzierungsbereich'],
    icon: '⚙️',
    badge: 'Duale Ausbildung',
    color: 'bg-orange-50 border-orange-200',
  },
  {
    id: 'fachschule',
    title: 'Fachschule für Technik',
    abschluss: 'Staatlich geprüfter Techniker',
    dauer: '2 Jahre (Vollzeit) / 4 Jahre (Teilzeit)',
    voraussetzung: 'Abgeschlossene Berufsausbildung + mind. 1 Jahr Berufspraxis',
    beschreibung: 'Die Fachschule für Technik bietet erfahrenen Fachkräften die Möglichkeit zur beruflichen Weiterbildung. Der Abschluss „Staatlich geprüfter Techniker" öffnet Türen zu Führungspositionen in Industrie und Handwerk.',
    faecher: ['Mathematik', 'Physik', 'Technisches Englisch', 'Betriebswirtschaft', 'Fachspezifische Lernfelder'],
    icon: '🔧',
    badge: 'Techniker',
    color: 'bg-red-50 border-red-200',
  },
];
---

<Layout
  title="Schulformen"
  description="Alle Schulformen der Wilhelm-Knapp-Schule Weilburg – Berufliches Gymnasium, Fachoberschule, Berufsfachschule, Berufsschule und Fachschule."
>
  <!-- Page Header -->
  <div class="bg-wks-navy text-white py-14">
    <div class="container">
      <div class="text-xs text-white/60 mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <span>Schulformen</span>
      </div>
      <h1 class="text-4xl font-extrabold mb-3">Educational Paths</h1>
      <p class="text-white/75 text-lg max-w-2xl">Vielfältige Bildungswege für Ihre berufliche Zukunft an der Wilhelm-Knapp-Schule Weilburg.</p>
    </div>
  </div>

  <!-- Content -->
  <div class="py-16 bg-[#f5f7fa]">
    <div class="container space-y-10 max-w-4xl">
      {schulformen.map((sf, i) => (
        <div
          id={sf.id}
          class={`rounded-2xl border p-8 shadow-sm bg-white hover:shadow-md transition-all animate-on-scroll`}
          style={`transition-delay: ${i * 100}ms`}
        >
          <div class="flex flex-col sm:flex-row gap-5 items-start">
            <div class={`w-16 h-16 rounded-2xl border flex items-center justify-center text-3xl shrink-0 ${sf.color}`}>
              {sf.icon}
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h2 class="text-xl font-bold text-wks-navy">{sf.title}</h2>
                <span class="text-xs font-semibold px-3 py-1 bg-wks-navy text-white rounded-full">{sf.badge}</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4 text-sm">
                <div>
                  <p class="font-semibold text-wks-navy text-xs uppercase tracking-wide mb-1">Abschluss</p>
                  <p class="text-muted-foreground">{sf.abschluss}</p>
                </div>
                <div>
                  <p class="font-semibold text-wks-navy text-xs uppercase tracking-wide mb-1">Dauer</p>
                  <p class="text-muted-foreground">{sf.dauer}</p>
                </div>
                <div>
                  <p class="font-semibold text-wks-navy text-xs uppercase tracking-wide mb-1">Voraussetzung</p>
                  <p class="text-muted-foreground text-xs">{sf.voraussetzung}</p>
                </div>
              </div>

              <p class="text-muted-foreground text-sm leading-relaxed mb-4">{sf.beschreibung}</p>

              <div class="flex flex-wrap gap-2">
                {sf.faecher.map(f => (
                  <span class="text-xs px-2.5 py-1 bg-wks-navy/8 text-wks-navy rounded-full font-medium" style="background:rgba(10,61,98,0.08)">{f}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="container text-center mt-12">
      <a href="/bewerbung" class="inline-flex items-center gap-2 px-8 py-4 bg-wks-orange text-white font-bold rounded-xl text-lg hover:bg-wks-orange-dark transition-all hover:-translate-y-0.5 hover:shadow-lg">
        Jetzt bewerben →
      </a>
    </div>
  </div>
</Layout>
